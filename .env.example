# ──────────────────────────────────────────────────────────────
#  Floox — Environment Variables
#  Copy this file to .env for local development.
#  In production, set these in Vercel Dashboard → Project → Settings → Environment Variables
#  NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Auth ──────────────────────────────────────────────────────
# Any long random string — used to sign JWTs
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# ── Email (Resend) ────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX

# ── Cloudinary (Media Uploads) ────────────────────────────────
# Get from: Cloudinary Dashboard → Settings → API Keys
# Cloud name is already set to 'cqes6im5' in the frontend — keep in sync
CLOUDINARY_CLOUD_NAME=cqes6im5
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# ── Event Sources (optional — BMS & District need no key) ─────
# Ticketmaster: developer.ticketmaster.com → My Apps → Create App
TICKETMASTER_API_KEY=YOUR_TICKETMASTER_KEY

# Eventbrite: eventbrite.com/platform → API Keys
EVENTBRITE_API_TOKEN=YOUR_EVENTBRITE_TOKEN

# Bandsintown: bandsintown.com/artist-signup → get app_id
BANDSINTOWN_APP_ID=YOUR_BANDSINTOWN_APP_ID
# Comma-separated artist names to track on Bandsintown
BANDSINTOWN_ARTISTS=Arijit Singh,Nucleya,When Chai Met Toast

# ── Cron Security ─────────────────────────────────────────────
# Protects /api/global-events-sync from unauthorized calls
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── Environment ───────────────────────────────────────────────
NODE_ENV=development
